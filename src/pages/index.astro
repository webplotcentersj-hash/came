---
import Base from '../layouts/Base.astro';
import LogoPremio from '../components/LogoPremio.astro';
import Formulario from '../components/Formulario.astro';
import Footer from '../components/Footer.astro';

export const prerender = false;

// process.env primero: permite cambiar la fecha en Vercel sin recompilar.
const fechaCierre =
  process.env.PUBLIC_FECHA_CIERRE ?? import.meta.env.PUBLIC_FECHA_CIERRE ?? '2026-09-30T23:59:00-03:00';
const cierre = new Date(fechaCierre);
const fecha = cierre.toLocaleDateString('es-AR', {
  weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Argentina/Buenos_Aires',
});
// Mayúscula solo en la inicial: "Miércoles, 30 de septiembre".
const cierreTexto = fecha.charAt(0).toUpperCase() + fecha.slice(1);
const cierreHora = cierre.toLocaleTimeString('es-AR', {
  hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'America/Argentina/Buenos_Aires',
});

const requisitos = [
  {
    titulo: 'De 18 a 40 años',
    detalle: 'Edad cumplida al momento del cierre de la convocatoria.',
    icono: 'edad',
  },
  {
    titulo: 'Empresa en San Juan con CUIT',
    detalle: 'Actividad registrada y radicada en la provincia, con cualquier figura fiscal.',
    icono: 'cuit',
  },
  {
    titulo: 'Mínimo 1 año operando',
    detalle: 'La empresa tiene que estar en funcionamiento hace al menos un año.',
    icono: 'tiempo',
  },
];

const ganadores = [
  { nombre: 'Alberto González', empresa: 'GOLAND Mining', logro: '1er premio nacional', anio: '2022', medalla: 'oro' },
  { nombre: 'Ángela Baudino', empresa: null, logro: '3er premio nacional', anio: '2023', medalla: 'bronce' },
  { nombre: 'Diego Alvarado', empresa: 'Plot Center', logro: 'Mención de Honor', anio: '2025', medalla: 'honor' },
];

const beneficios = [
  {
    icono: 'red',
    titulo: 'Red nacional de empresarios',
    texto: 'Entrás a la red de CAME Joven y te sentás a la mesa con jóvenes empresarios de todo el país.',
  },
  {
    icono: 'visibilidad',
    titulo: 'Visibilidad para tu marca',
    texto: 'Cobertura en medios provinciales y nacionales, y difusión en los canales de las entidades organizadoras.',
  },
  {
    icono: 'nacional',
    titulo: 'Pase a la instancia nacional',
    texto: 'El ganador provincial representa a San Juan en el Premio Joven Empresario Argentino.',
  },
  {
    icono: 'mentoria',
    titulo: 'Mentoría y capacitación',
    texto: 'Acceso a programas de formación, rondas de negocios y acompañamiento de la FESJ.',
  },
];

const pasos = [
  { n: '01', titulo: 'Verificá los requisitos', texto: 'Edad, CUIT en San Juan y un año de operación. Nada más.' },
  { n: '02', titulo: 'Completá el formulario', texto: 'Datos de la empresa y tu historia. Cinco minutos, sin papeles.' },
  { n: '03', titulo: 'Te contactamos', texto: 'El jurado revisa las postulaciones y pide documentación complementaria.' },
  { n: '04', titulo: 'Premiación', texto: 'Se anuncian los ganadores en el evento provincial de entrega.' },
];

const faqs = [
  {
    p: '¿Tiene costo postularse?',
    r: 'No. La inscripción al Premio Joven Empresario Sanjuanino es totalmente gratuita.',
  },
  {
    p: '¿Puedo postularme si mi empresa es unipersonal o monotributista?',
    r: 'Sí. Lo que se evalúa es el proyecto empresarial: cualquier figura fiscal registrada en San Juan con CUIT es válida, incluidos monotributistas y sociedades de todo tipo.',
  },
  {
    p: '¿Qué pasa si tengo más de 40 años pero mi socio no?',
    r: 'La postulación debe presentarla la persona que cumple con el rango de edad de 18 a 40 años y que tenga participación en la conducción de la empresa.',
  },
  {
    p: '¿Puedo nominar a otra persona?',
    r: 'Sí. Elegí la opción "Nomino a alguien" en el formulario. Nos ponemos en contacto con esa persona para que complete su postulación.',
  },
  {
    p: '¿Qué evalúa el jurado?',
    r: 'Trayectoria y crecimiento de la empresa, innovación, generación de empleo, impacto en la comunidad sanjuanina y sostenibilidad del proyecto.',
  },
  {
    p: '¿Qué documentación necesito?',
    r: 'Para inscribirte, ninguna. Si avanzás en el proceso, el jurado puede solicitar constancia de CUIT, documentación societaria y material de respaldo de la empresa.',
  },
];

const ticker = [
  'Inscripción gratuita',
  'De 18 a 40 años',
  'Empresa en San Juan',
  '5 minutos de formulario',
  'Sin papeles',
  'Pase a la instancia nacional',
];
---

<Base precargarHero>
  <a href="#postulate" class="saltar">Ir al formulario de postulación</a>

  <!-- ==================== BARRA ==================== -->
  <header class="barra" id="barra">
    <div class="contenedor barra-int">
      <a href="/" class="marca" aria-label="Premio Joven Empresario Sanjuanino, inicio">
        <span class="marca-logo">
          <LogoPremio size={36} variante="blanco" class="logo-claro" eager />
          <LogoPremio size={36} variante="violeta" class="logo-oscuro" eager />
        </span>
        <span class="marca-texto">
          <strong>Premio Joven Empresario</strong>
          <em>Sanjuanino · Edición 2026</em>
        </span>
      </a>
      <nav class="nav" aria-label="Secciones">
        <a href="#requisitos">Requisitos</a>
        <a href="#beneficios">Beneficios</a>
        <a href="#como">Cómo participar</a>
        <a href="#faq">Preguntas</a>
      </nav>
      <a href="#postulate" class="btn btn-primario btn-sm cta-barra" data-abrir-tipo="postulacion">
        Postulate
      </a>
    </div>
  </header>

  <!-- ==================== HERO ==================== -->
  <section class="hero grano">
    <img
      class="hero-foto"
      src="/hongo-1920.jpg"
      srcset="/hongo-640.jpg 640w, /hongo-1100.jpg 1100w, /hongo-1920.jpg 1920w"
      sizes="100vw"
      width="1920"
      height="1401"
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero-tinte" aria-hidden="true"></div>
    <div class="hero-velo" aria-hidden="true"></div>
    <div class="hero-aurora" aria-hidden="true">
      <span class="blob blob-1"></span>
      <span class="blob blob-2"></span>
      <span class="blob blob-3"></span>
    </div>
    <div class="hero-estrellas" aria-hidden="true">
      <span style="--x:12%; --y:22%; --t:0s"></span>
      <span style="--x:88%; --y:16%; --t:1.1s"></span>
      <span style="--x:76%; --y:38%; --t:2.3s"></span>
      <span style="--x:22%; --y:58%; --t:1.7s"></span>
      <span style="--x:94%; --y:62%; --t:.6s"></span>
      <span style="--x:6%; --y:44%; --t:2.9s"></span>
    </div>

    <div class="contenedor hero-int">
      <span class="pastilla pastilla-edicion">
        <i class="punto"></i> Edición 2026 · Convocatoria abierta
      </span>

      <LogoPremio size={132} variante="blanco" class="hero-emblema" eager />

      <h1 class="hero-titulo">
        <span class="linea-1">Premio</span>
        <span class="linea-2 texto-oro">Joven Empresario</span>
        <span class="linea-3">Sanjuanino</span>
      </h1>

      <p class="lema">Vos merecés ser reconocido</p>

      <p class="hero-bajada">
        Si tenés entre 18 y 40 años y una empresa en San Juan, esta es tu oportunidad de que
        tu trabajo se vea. Postularte es gratis y lleva cinco minutos.
      </p>

      <div class="hero-ctas">
        <a href="#postulate" class="btn btn-primario btn-lg" data-abrir-tipo="postulacion">
          Postulate ahora
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10h11M11 5.5 15.5 10 11 14.5"/></svg>
        </a>
        <a href="#postulate" class="btn btn-contorno btn-lg" data-abrir-tipo="nominacion">Nominá a alguien</a>
      </div>

      <div class="cuenta vidrio" id="cuenta" data-cierre={cierre.toISOString()}>
        <p class="cuenta-titulo">La convocatoria cierra en</p>
        <div class="cuenta-grid">
          <div><strong data-u="d">--</strong><span>días</span></div>
          <i aria-hidden="true">:</i>
          <div><strong data-u="h">--</strong><span>horas</span></div>
          <i aria-hidden="true">:</i>
          <div><strong data-u="m">--</strong><span>min</span></div>
          <i aria-hidden="true">:</i>
          <div><strong data-u="s">--</strong><span>seg</span></div>
        </div>
        <p class="cuenta-fecha">{cierreTexto} · {cierreHora} h</p>
      </div>
    </div>

    <a href="#requisitos" class="hero-scroll" aria-label="Ver requisitos">
      <span></span>
    </a>
  </section>

  <!-- ==================== TICKER ==================== -->
  <div class="ticker" aria-hidden="true">
    <div class="ticker-pista">
      {[0, 1].map(() => (
        <div class="ticker-grupo">
          {ticker.map((t) => (
            <span class="ticker-item">
              {t}
              <i class="ticker-sep">★</i>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- ==================== REQUISITOS ==================== -->
  <section class="seccion requisitos" id="requisitos">
    <div class="halo halo-rosa" aria-hidden="true"></div>
    <div class="contenedor">
      <header class="seccion-header reveal">
        <span class="pastilla pastilla-violeta">Requisitos</span>
        <h2>Tres condiciones.<br />Nada más.</h2>
        <p class="seccion-bajada">
          No hay letra chica ni papeleo previo. Si cumplís estos tres puntos, ya podés postularte.
        </p>
      </header>

      <ul class="req-grid">
        {requisitos.map((r, i) => (
          <li class="req-card reveal" style={`--d:${i * 110}ms`}>
            <span class="req-fantasma" aria-hidden="true">{i + 1}</span>
            <span class="req-icono" aria-hidden="true">
              {r.icono === 'edad' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="3.6" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" />
                </svg>
              )}
              {r.icono === 'cuit' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="M7 10h4M7 14h7M16 9.5h2" />
                </svg>
              )}
              {r.icono === 'tiempo' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
                </svg>
              )}
            </span>
            <h3>{r.titulo}</h3>
            <p>{r.detalle}</p>
          </li>
        ))}
      </ul>

      <p class="req-pie reveal">
        <a href="#postulate" class="btn btn-violeta" data-abrir-tipo="postulacion">Cumplo los tres, quiero postularme</a>
      </p>
    </div>
  </section>

  <!-- ==================== GANADORES ==================== -->
  <section class="seccion ganadores grano">
    <div class="contenedor">
      <header class="seccion-header reveal">
        <span class="pastilla pastilla-oro">Antecedentes</span>
        <h2 class="claro">San Juan sabe ganar</h2>
        <p class="seccion-bajada claro-suave">
          Empresarios sanjuaninos que llegaron a lo más alto de la instancia nacional.
          El próximo nombre de esta lista puede ser el tuyo.
        </p>
      </header>

      <ul class="gan-grid">
        {ganadores.map((g, i) => (
          <li class={`gan-card vidrio reveal medalla-${g.medalla}`} style={`--d:${i * 120}ms`}>
            <span class="gan-cinta" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="9" r="5.5" /><path d="M8.5 13.5 7 22l5-2.6L17 22l-1.5-8.5" />
              </svg>
            </span>
            <span class="gan-anio">{g.anio}</span>
            <h3>{g.nombre}</h3>
            {g.empresa && <p class="gan-empresa">{g.empresa}</p>}
            <p class="gan-logro">{g.logro}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== BENEFICIOS ==================== -->
  <section class="seccion beneficios" id="beneficios">
    <div class="halo halo-violeta" aria-hidden="true"></div>
    <div class="contenedor">
      <header class="seccion-header reveal">
        <span class="pastilla pastilla-violeta">Beneficios</span>
        <h2>Qué ganás además del premio</h2>
      </header>

      <ul class="ben-grid">
        {beneficios.map((b, i) => (
          <li class="ben-card reveal" style={`--d:${i * 90}ms`}>
            <span class="ben-icono" aria-hidden="true">
              {b.icono === 'red' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="5" r="2.4" /><circle cx="5" cy="18" r="2.4" /><circle cx="19" cy="18" r="2.4" />
                  <path d="M10.4 6.9 6.6 15.7M13.6 6.9l3.8 8.8M7.4 18h9.2" />
                </svg>
              )}
              {b.icono === 'visibilidad' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 11v3a1 1 0 0 0 1 1h3l5 4V6L7 10H4a1 1 0 0 0-1 1Z" /><path d="M16 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" />
                </svg>
              )}
              {b.icono === 'nacional' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 4h10v6a5 5 0 0 1-10 0V4Z" /><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3M12 15v4M8.5 21h7" />
                </svg>
              )}
              {b.icono === 'mentoria' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5 3 9l9 4 9-4-9-4Z" /><path d="M7 11v4.5c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5V11M21 9v5" />
                </svg>
              )}
            </span>
            <div>
              <h3>{b.titulo}</h3>
              <p>{b.texto}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ==================== CÓMO PARTICIPAR ==================== -->
  <section class="seccion pasos" id="como">
    <div class="contenedor">
      <header class="seccion-header reveal">
        <span class="pastilla pastilla-violeta">Cómo participar</span>
        <h2>De la idea a la postulación</h2>
      </header>

      <ol class="pasos-grid">
        {pasos.map((p, i) => (
          <li class="paso reveal" style={`--d:${i * 100}ms`}>
            <span class="paso-marca">
              <span class="paso-punto" aria-hidden="true"></span>
              <span class="paso-n">{p.n}</span>
            </span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ==================== FRANJA CTA ==================== -->
  <section class="franja">
    <div class="contenedor franja-int reveal">
      <div>
        <h2>¿Y si este año te toca a vos?</h2>
        <p>Gratis, sin papeles y en cinco minutos. Lo único que se pierde seguro es lo que no se presenta.</p>
      </div>
      <a href="#postulate" class="btn btn-violeta btn-lg" data-abrir-tipo="postulacion">Quiero postularme</a>
    </div>
  </section>

  <!-- ==================== FORMULARIO ==================== -->
  <Formulario />

  <!-- ==================== FAQ ==================== -->
  <section class="seccion faq" id="faq">
    <div class="contenedor contenedor-angosto">
      <header class="seccion-header reveal">
        <span class="pastilla pastilla-violeta">Preguntas frecuentes</span>
        <h2>Lo que más nos consultan</h2>
      </header>

      <div class="faq-lista">
        {faqs.map((f, i) => (
          <details class="faq-item reveal" style={`--d:${i * 60}ms`}>
            <summary>{f.p}</summary>
            <div class="faq-cuerpo"><p>{f.r}</p></div>
          </details>
        ))}
      </div>

      <p class="faq-pie reveal">
        ¿Te quedó otra duda? Escribinos a
        <a href="mailto:premio@camejovensanjuan.org">premio@camejovensanjuan.org</a>
      </p>
    </div>
  </section>

  <Footer />

  <!-- ==================== CTA MÓVIL FIJA ==================== -->
  <div class="cta-movil" id="cta-movil">
    <div>
      <strong>Inscripción gratuita</strong>
      <span id="cta-movil-dias">Convocatoria abierta</span>
    </div>
    <a href="#postulate" class="btn btn-primario btn-sm" data-abrir-tipo="postulacion">Postulate</a>
  </div>

  <script>
    /* ---------- barra: sólida al hacer scroll ---------- */
    const barra = document.getElementById('barra')!;
    const ctaMovil = document.getElementById('cta-movil')!;
    const formulario = document.getElementById('postulate');

    const alScrollear = () => {
      barra.classList.toggle('flotando', window.scrollY > 40);
      ctaMovil.classList.toggle('visible', window.scrollY > 520);
    };
    alScrollear();
    window.addEventListener('scroll', alScrollear, { passive: true });

    // La barra fija se esconde cuando el formulario está a la vista.
    if (formulario) {
      new IntersectionObserver(
        ([e]) => ctaMovil.classList.toggle('oculta', e.isIntersecting),
        { threshold: 0.06 },
      ).observe(formulario);
    }

    /* ---------- revelado al hacer scroll ---------- */
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observador.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -60px' },
    );
    document.querySelectorAll('.reveal').forEach((el) => observador.observe(el));

    /* ---------- cuenta regresiva ---------- */
    const cuenta = document.getElementById('cuenta')!;
    const objetivo = new Date(cuenta.dataset.cierre!).getTime();
    const casillas: Record<string, HTMLElement> = {};
    cuenta.querySelectorAll<HTMLElement>('[data-u]').forEach((el) => { casillas[el.dataset.u!] = el; });
    const diasMovil = document.getElementById('cta-movil-dias')!;

    const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');

    function tick() {
      const falta = objetivo - Date.now();
      if (falta <= 0) {
        cuenta.classList.add('cerrada');
        cuenta.querySelector('.cuenta-titulo')!.textContent = 'La convocatoria está cerrada';
        Object.values(casillas).forEach((el) => { el.textContent = '00'; });
        diasMovil.textContent = 'Convocatoria cerrada';
        clearInterval(intervalo);
        return;
      }
      const s = Math.floor(falta / 1000);
      const dias = Math.floor(s / 86400);
      casillas.d.textContent = String(dias);
      casillas.h.textContent = pad(Math.floor(s / 3600) % 24);
      casillas.m.textContent = pad(Math.floor(s / 60) % 60);
      casillas.s.textContent = pad(s % 60);
      diasMovil.textContent = dias > 0 ? `Cierra en ${dias} ${dias === 1 ? 'día' : 'días'}` : 'Último día';
    }
    tick();
    const intervalo = setInterval(tick, 1000);

    /* ---------- parallax suave de la foto del hero ---------- */
    const foto = document.querySelector<HTMLElement>('.hero-foto');
    if (foto && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let pendiente = false;
      window.addEventListener('scroll', () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          const y = Math.min(window.scrollY, 900);
          foto.style.transform = `scale(1.08) translate3d(0, ${y * 0.16}px, 0)`;
          pendiente = false;
        });
      }, { passive: true });
    }
  </script>
</Base>

<style>
  /* ===================== accesibilidad ===================== */
  .saltar {
    position: absolute; left: -9999px; top: 0; z-index: 200;
    background: var(--violeta); color: #fff; padding: .85rem 1.4rem;
    border-radius: 0 0 10px 0; font-weight: 600;
  }
  .saltar:focus { left: 0; }

  /* ===================== barra ===================== */
  .barra {
    position: fixed; inset: 0 0 auto 0; z-index: 60;
    transition: background-color .35s ease, box-shadow .35s ease, backdrop-filter .35s ease, padding .35s ease;
    padding-block: .55rem;
  }
  .barra-int { display: flex; align-items: center; gap: 1.5rem; height: 60px; }

  .marca { display: flex; align-items: center; gap: .7rem; color: #fff; }
  .marca:hover { text-decoration: none; }
  .marca-logo { position: relative; display: block; width: 36px; height: 40px; flex-shrink: 0; }
  .marca-logo :global(img) { position: absolute; inset: 0; transition: opacity .35s ease; }
  .marca-logo :global(.logo-oscuro) { opacity: 0; }
  .marca-texto strong { display: block; font-family: var(--display); font-size: .92rem; font-weight: 700; line-height: 1.15; letter-spacing: -.02em; }
  .marca-texto em { display: block; font-size: .7rem; font-style: normal; opacity: .72; }
  @media (max-width: 480px) { .marca-texto { display: none; } }

  .nav { display: flex; gap: 1.75rem; margin-left: auto; font-size: .88rem; font-weight: 500; }
  .nav a { color: rgba(255, 255, 255, .82); position: relative; }
  .nav a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: -5px; height: 2px;
    background: var(--arena); border-radius: 2px;
    transform: scaleX(0); transform-origin: left; transition: transform .28s ease;
  }
