---
import '../../styles/global.css';
import LogoPremio from '../../components/LogoPremio.astro';
import { createSession, findAdminByEmail, verifyPassword, getSession, countAdmins } from '../../lib/auth';

export const prerender = false;

// Si ya hay sesión activa, al panel directo.
if (getSession(Astro.cookies)) {
  return Astro.redirect('/admin');
}

const destino = Astro.url.searchParams.get('next') || '/admin';
const sinAdmins = (await countAdmins()) === 0;

let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  const admin = email ? await findAdminByEmail(email) : undefined;

  if (admin && verifyPassword(password, admin.password_hash)) {
    createSession(Astro.cookies, admin);
    return Astro.redirect(destino.startsWith('/admin') ? destino : '/admin');
  }
  error = 'Email o contraseña incorrectos.';
}
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ingresar al panel</title>
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="login">
      <div class="caja tarjeta">
        <LogoPremio size={76} variante="violeta" class="emblema-login" />
        <h1>Panel de postulaciones</h1>
        <p class="sub">Premio Joven Empresario Sanjuanino</p>

        {sinAdmins && (
          <div class="aviso">
            Todavía no hay ningún usuario creado. Ejecutá <code>npm run admin:create</code> en el
            servidor para dar de alta el primero.
          </div>
        )}

        {error && <div class="error-box" role="alert">{error}</div>}

        <form method="post">
          <div class="campo">
            <label for="email">Email</label>
            <input class="control" id="email" name="email" type="email" required autocomplete="username" value={email} autofocus />
          </div>
          <div class="campo">
            <label for="password">Contraseña</label>
            <input class="control" id="password" name="password" type="password" required autocomplete="current-password" />
          </div>
          <button type="submit" class="btn btn-violeta ancho">Ingresar</button>
        </form>

        <a href="/" class="volver">← Volver al sitio</a>
      </div>
    </main>
  </body>
</html>

<style>
  .login {
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 2rem 1.25rem;
    background: linear-gradient(160deg, var(--rosa) 0%, #b78ac9 55%, var(--violeta) 100%);
  }
  .caja { width: 100%; max-width: 420px; padding: 2.5rem 2rem; text-align: center; }
  .caja :global(.emblema-login) { margin: 0 auto 1.35rem; }
  h1 { font-size: 1.45rem; color: var(--violeta); margin-bottom: .2rem; }
  .sub { font-size: .82rem; color: var(--tinta-suave); margin-bottom: 1.75rem; }

  form { text-align: left; }
  .ancho { width: 100%; margin-top: .5rem; }

  .error-box {
    background: #fdeceb; color: var(--alerta); border: 1px solid #f3c9c3;
    border-radius: 10px; padding: .7rem 1rem; font-size: .85rem; font-weight: 600;
    margin-bottom: 1.25rem;
  }
  .aviso {
    background: var(--rosa-3); border: 1px solid var(--rosa);
    border-radius: 10px; padding: .8rem 1rem; font-size: .8rem; color: var(--tinta-suave);
    margin-bottom: 1.25rem; text-align: left; line-height: 1.5;
  }
  .aviso code { background: #fff; padding: .1rem .35rem; border-radius: 4px; font-size: .78rem; color: var(--violeta); }

  .volver { display: inline-block; margin-top: 1.5rem; font-size: .82rem; color: var(--tinta-suave); }
</style>
