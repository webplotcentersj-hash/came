---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  precargarHero?: boolean;
}

const TITULO_DEFAULT = 'Premio Joven Empresario Sanjuanino 2026 | Inscripción abierta';
const DESCRIPCION_DEFAULT =
  'La convocatoria cierra el 14 de septiembre. Si tenés entre 18 y 40 años y una empresa en San Juan, postulate gratis. La premiación es el 17 de septiembre.';

const {
  title = TITULO_DEFAULT,
  description = DESCRIPCION_DEFAULT,
  noindex = false,
  precargarHero = false,
} = Astro.props;

const origen = Astro.site ?? Astro.url;
const urlCanonico = new URL(Astro.url.pathname, origen).href;
const imagenOg = new URL('/og.jpg?v=20260901', origen).href;
const nombreSitio = 'Premio Joven Empresario Sanjuanino';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="CAME Joven, JeFES, FESJ y CAME" />
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />
    }
    <meta name="theme-color" content="#250a3a" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={urlCanonico} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={nombreSitio} />
    <meta property="og:url" content={urlCanonico} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imagenOg} />
    <meta property="og:image:secure_url" content={imagenOg} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Premio Joven Empresario Sanjuanino 2026. Inscripción abierta. El Hongo de Ischigualasto al fondo." />
    <meta name="image" content={imagenOg} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imagenOg} />
    <meta name="twitter:image:alt" content="Premio Joven Empresario Sanjuanino 2026. Inscripción abierta." />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {precargarHero && (
      <link
        rel="preload"
        as="image"
        href="/hongo-1920.jpg"
        imagesrcset="/hongo-640.jpg 640w, /hongo-1100.jpg 1100w, /hongo-1920.jpg 1920w"
        imagesizes="100vw"
      />
    )}

    {!noindex && (
      <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: nombreSitio,
        url: new URL('/', origen).href,
        description,
        inLanguage: 'es-AR',
        image: imagenOg,
        publisher: {
          '@type': 'Organization',
          name: 'CAME Joven San Juan',
          url: new URL('/', origen).href,
        },
      })} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
