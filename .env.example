# =====================================================================
#  Copiar a .env y completar. El .env NO se versiona.
# =====================================================================

# --- Base de datos ---
# Local: archivo SQLite dentro de ./data (se crea solo)
DATABASE_URL="file:./data/premio.db"

# Produccion (Vercel): Turso. El sistema de archivos de Vercel es efimero,
# asi que una base en archivo NO sirve ahi.
# DATABASE_URL="libsql://premio-tuusuario.turso.io"
# DATABASE_AUTH_TOKEN="ey..."

# --- Seguridad del panel ---
# Obligatoria, minimo 16 caracteres. Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-esta-clave-por-una-larga-y-aleatoria"

# --- Fecha de cierre de la convocatoria (ISO 8601 con huso horario) ---
# Alimenta la cuenta regresiva del hero y la barra fija de mobile.
PUBLIC_FECHA_CIERRE="2026-09-30T23:59:00-03:00"
