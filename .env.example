# --- Base de datos (Supabase del proyecto Came Joven) ---
SUPABASE_URL="https://ftdhunbwaglhxuwnbrit.supabase.co"
# Settings → API → service_role (secret). Nunca en el cliente ni en git.
SUPABASE_SERVICE_ROLE_KEY="ey..."

# --- Seguridad del panel ---
# Obligatoria, minimo 16 caracteres. Generar una nueva con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="cambiar-esta-clave-por-una-larga-y-aleatoria"

# --- Fecha de cierre de la convocatoria (ISO 8601 con huso horario) ---
# Alimenta la cuenta regresiva del hero y la barra fija de mobile.
PUBLIC_FECHA_CIERRE="2026-09-30T23:59:00-03:00"
